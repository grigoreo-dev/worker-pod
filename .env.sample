TZ=Europe/Berlin
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
SSH_PUBLIC_KEY=
GH_TOKEN=

# opencode serve (default: true; set false for ACP/SSH-only scenario)
OPENCODE_SERVE=true

# opencode-mcp HTTP transport (optional — не запускается если не задан)
OPENCODE_MCP_HTTP_TOKEN=
OPENCODE_MCP_HTTP_PORT=3000
